# Interfaces que recebem o espelhamento (SPAN/TAP), sem IP configurado. Ex.: ens224,ens256
CAPTURE_IFACES=ens224
# Portas DNP3 usadas pelas RTUs
DNP3_PORTS=20000
# IPs e/ou redes dos FEPs do ADMS, separados por vírgula, sem espaços.
# Requisições DNP3 vindas de qualquer outro IP geram o alerta "master não autorizado".
# Ex.: AUTHORIZED_MASTERS=10.0.0.11,10.0.0.12,10.1.0.11,10.1.0.12
#      AUTHORIZED_MASTERS=10.0.0.0/28,10.1.0.0/28,192.168.50.7
# Vazio = não verifica.
AUTHORIZED_MASTERS=
# Senhas (troque!)
CH_PASSWORD=troque-esta-senha
GRAFANA_CH_PASSWORD=troque-esta-senha-tambem
GRAFANA_ADMIN_PASSWORD=admin-troque
# Diretório de dados (pcap, banco, grafana)
DATA_DIR=/srv/dnp3mon
# Retenção do pcap bruto
PCAP_DAYS=30
PCAP_MAX_GB=0
# Portas extras guardadas no pcap além das DNP3 (2404 = IEC 104, para a fase 2). "all" grava tudo da interface.
PCAP_EXTRA_PORTS=2404
# Endereço pelo qual os navegadores acessam a API do dnp3mon (links "ao vivo" e "baixar pcap" no Grafana)
DNP3MON_PUBLIC_URL=http://monitor-dnp3.exemplo.local:8080
# Ajustes de detecção
RESP_TIMEOUT=30s
OFFLINE_AFTER=10m
