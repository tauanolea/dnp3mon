  {
   "type": "timeseries",
   "title": "TCP (por minuto)",
   "description": "",
   "id": 9,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(minute) AS time, sum(tcp_retrans) AS retransmissoes, sum(tcp_gaps) AS lacunas_captura, sum(tcp_resets) AS resets,\n  sum(tcp_connect_fail) AS conexoes_falhas, sum(tcp_syn_retry) AS syn_repetidos, sum(tcp_connects) AS conexoes\nFROM dnp3.rtu_stats_1m WHERE $__timeFilter(minute) GROUP BY time ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Latências médias",
   "description": "",
   "id": 10,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(minute) AS time, sum(tcp_rtt_sum_ms) / sum(tcp_rtt_cnt) AS rtt_tcp, sum(link_rtt_sum_ms) / sum(link_rtt_cnt) AS link_status,\n  sum(resp_sum_ms) / sum(resp_cnt) AS resposta_aplicacao\nFROM dnp3.rtu_stats_1m WHERE $__timeFilter(minute) GROUP BY time ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Tráfego por master (FEP)",
   "description": "",
   "id": 11,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(minute) AS time, active_master, 8 * sum(bytes_m2o + bytes_o2m) / greatest($__interval_s, 60) / 1000 AS kbps\nFROM dnp3.rtu_stats_1m WHERE $__timeFilter(minute) AND active_master != '' GROUP BY time, active_master ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Kbits",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "displayName": "${__field.labels.active_master}"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "table",
   "title": "Latência e erros por RTU",
   "description": "",
   "id": 12,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT s.rtu AS rtu, inv.medium AS meio,\n  round(sum(s.tcp_rtt_sum_ms) / nullIf(sum(s.tcp_rtt_cnt), 0)) AS rtt_medio_ms, round(max(s.tcp_rtt_max_ms)) AS rtt_max_ms,\n  round(sum(s.link_rtt_sum_ms) / nullIf(sum(s.link_rtt_cnt), 0)) AS link_status_ms,\n  sum(s.tcp_retrans) AS retrans, round(100 * sum(s.tcp_retrans) / nullIf(sum(s.pkts_m2o + s.pkts_o2m), 0), 2) AS retrans_pct,\n  sum(s.link_crc_err) AS crc, sum(s.tcp_resets) AS resets, sum(s.tcp_connect_fail) AS conexoes_falhas\nFROM dnp3.rtu_stats_1m AS s LEFT JOIN (SELECT rtu, name, medium, region FROM dnp3.rtu_inventory FINAL) AS inv ON inv.rtu = toString(s.rtu)\nWHERE $__timeFilter(s.minute) GROUP BY s.rtu, inv.medium ORDER BY rtt_medio_ms DESC LIMIT 100",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "rtt_medio_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "rtt_max_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "link_status_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
