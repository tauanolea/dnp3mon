    }
   }
  },
  {
   "type": "timeseries",
   "title": "Tempo de resposta por requisição (ms)",
   "description": "",
   "id": 11,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT ts AS time, req_kind, resp_ms FROM dnp3.messages\nWHERE rtu = '${rtu}' AND $__timeFilter(ts) AND dir = 'O2M' AND resp_ms IS NOT NULL ORDER BY ts",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "points",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      },
      "pointSize": 4
     },
     "color": {
      "mode": "palette-classic"
     },
     "displayName": "${__field.labels.req_kind}"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Mensagens por minuto",
   "description": "",
   "id": 12,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT minute AS time, app_req AS requisicoes, app_resp AS respostas, app_unsol AS nao_solicitadas, app_confirm AS confirmacoes,\n  link_status_req AS link_status, app_timeouts AS timeouts, app_retries AS retentativas\nFROM dnp3.rtu_stats_1m WHERE rtu = '${rtu}' AND $__timeFilter(minute) ORDER BY minute",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
