{
 "uid": "dnp3-rtu",
 "title": "DNP3 · Detalhe da RTU",
 "description": "Tudo sobre uma RTU: comunicação, mensagens, pontos e comandos",
 "tags": [
  "dnp3"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "rtu",
    "label": "RTU (ip:porta)",
    "type": "query",
    "datasource": {
     "type": "grafana-clickhouse-datasource",
     "uid": "clickhouse"
    },
    "query": "SELECT DISTINCT rtu FROM dnp3.rtu_stats_1m WHERE minute > now() - INTERVAL 2 DAY ORDER BY rtu",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "hide": 0
   },
   {
    "name": "ponto",
    "label": "Pontos",
    "type": "query",
    "datasource": {
     "type": "grafana-clickhouse-datasource",
     "uid": "clickhouse"
    },
    "query": "SELECT concat(type, ':', toString(idx)) FROM dnp3.point_last FINAL WHERE rtu = '${rtu}' ORDER BY type, idx",
    "refresh": 1,
    "includeAll": false,
    "multi": true,
    "hide": 0
   },
   {
    "name": "api",
    "label": "API dnp3mon",
    "type": "textbox",
    "query": "http://localhost:8080",
    "current": {
     "text": "http://localhost:8080",
     "value": "http://localhost:8080"
    },
    "hide": 0
   }
  ]
 },
 "links": [
  {
   "title": "DNP3",
   "type": "dashboards",
   "tags": [
    "dnp3"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true
  },
  {
   "title": "Tráfego ao vivo desta RTU",
   "type": "link",
   "url": "${api}/?rtu=${rtu}",
   "targetBlank": true,
   "icon": "bolt"
  },
  {
   "title": "Baixar PCAP do intervalo",
   "type": "link",
   "url": "${api}/api/pcap?rtu=${rtu}&from=${__from}&to=${__to}",
   "targetBlank": true,
   "icon": "download-alt"
  }
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Estado",
   "description": "",
   "id": 1,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT if(argMax(online, minute) = 1, 'ONLINE', 'OFFLINE') FROM dnp3.rtu_stats_1m WHERE rtu = '${rtu}' AND minute <= $__toTime AND minute > $__toTime - INTERVAL 1 DAY",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "ONLINE": {
         "color": "green"
        },
        "OFFLINE": {
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
