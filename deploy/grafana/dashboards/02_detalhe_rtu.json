  {
   "type": "timeseries",
   "title": "Período entre integridades (s)",
   "description": "Intervalo entre pedidos de integridade (classe 0) do master. Esperado: 300 s.",
   "id": 20,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 55,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT time, periodo_s FROM (\n  SELECT ts AS time, dateDiff('millisecond', lagInFrame(ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), ts) / 1000 AS periodo_s\n  FROM dnp3.messages WHERE rtu = '${rtu}' AND $__timeFilter(ts) AND dir = 'M2O' AND kind = 'integrity' AND retry = 0)\nWHERE periodo_s < 86400 ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
