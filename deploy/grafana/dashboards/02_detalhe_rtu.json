      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Rede: RTT, retransmissões e erros",
   "description": "",
   "id": 13,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT minute AS time, tcp_rtt_sum_ms / nullIf(tcp_rtt_cnt, 0) AS rtt_tcp_ms, link_rtt_sum_ms / nullIf(link_rtt_cnt, 0) AS link_status_ms,\n  tcp_retrans AS retrans_tcp, link_crc_err AS crc, tcp_connect_fail AS conexoes_falhas\nFROM dnp3.rtu_stats_1m WHERE rtu = '${rtu}' AND $__timeFilter(minute) ORDER BY minute",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(retrans_tcp|crc|conexoes_falhas)$"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "custom.drawStyle",
        "value": "bars"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Valores dos pontos selecionados",
   "description": "Escolha os pontos na variável 'Pontos'. Eventos e mudanças de estático.",
   "id": 14,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT ts AS time, concat(type, ':', toString(idx)) AS ponto, value FROM dnp3.points\nWHERE rtu = '${rtu}' AND $__timeFilter(ts) AND concat(type, ':', toString(idx)) IN (${ponto:singlequote}) ORDER BY ts",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "always",
      "spanNulls": false,
      "stacking": {
