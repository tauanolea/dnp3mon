  {
   "type": "stat",
   "title": "IIN",
   "description": "",
   "id": 9,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 21,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT if(empty(x), 'normal', arrayStringConcat(x, ' ')) FROM (SELECT arrayFilter(x -> x != '', [\n  if(bitTest(argMax(iin, minute), 15), 'RESTART', ''), if(bitTest(argMax(iin, minute), 14), 'TROUBLE', ''),\n  if(bitTest(argMax(iin, minute), 13), 'LOCAL', ''), if(bitTest(argMax(iin, minute), 12), 'NEED_TIME', ''),\n  if(bitTest(argMax(iin, minute), 5), 'CONFIG_CORRUPT', ''), if(bitTest(argMax(iin, minute), 3), 'EVENT_OVERFLOW', '')]) AS x FROM dnp3.rtu_stats_1m WHERE rtu = '${rtu}' AND minute <= $__toTime AND minute > $__toTime - INTERVAL 1 DAY)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
