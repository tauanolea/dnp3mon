  {
   "type": "timeseries",
   "title": "Comandos por resultado",
   "description": "",
   "id": 9,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 16,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(ts) AS time, result, count() AS n FROM dnp3.commands WHERE $__timeFilter(ts) GROUP BY time, result ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "displayName": "${__field.labels.result}"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "table",
   "title": "Falhas por status",
   "description": "",
   "id": 10,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT result AS resultado, if(status = '', select_status, status) AS status, count() AS n FROM dnp3.commands\nWHERE $__timeFilter(ts) AND result NOT IN ('success','sent_no_ack') GROUP BY resultado, status ORDER BY n DESC",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
  {
   "type": "table",
   "title": "RTUs com mais falhas de comando",
   "description": "",
   "id": 11,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 10,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT c.rtu AS rtu, count() AS comandos, countIf(c.result NOT IN ('success','sent_no_ack')) AS falhas,\n  round(100 * falhas / comandos, 1) AS falha_pct, groupUniqArrayIf(concat(c.result, if(c.status = '' AND c.select_status = '', '', concat(':', if(c.status = '', c.select_status, c.status)))), c.result NOT IN ('success','sent_no_ack')) AS tipos_falha\nFROM dnp3.commands AS c WHERE $__timeFilter(c.ts) GROUP BY c.rtu HAVING falhas > 0 ORDER BY falhas DESC LIMIT 50",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
