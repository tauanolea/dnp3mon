  {
   "type": "table",
   "title": "Todos os comandos",
   "description": "",
   "id": 13,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT ts, rtu, mode AS modo, concat(type, ':', toString(idx)) AS ponto, op AS operacao, select_status, status, result AS resultado,\n  round(duration_ms) AS duracao_ms, round(select_to_operate_ms) AS sel_op_ms, feedback_point AS retorno, round(feedback_ms) AS retorno_ms,\n  retries AS retent, master, detail AS detalhe\nFROM dnp3.commands WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 2000",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "resultado"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "success": {
            "color": "green",
            "index": 0
           },
           "sent_no_ack": {
            "color": "green",
            "index": 1
           },
           "failed": {
            "color": "red",
            "index": 2
           },
           "timeout": {
            "color": "red",
            "index": 3
           },
           "select_failed": {
            "color": "red",
            "index": 4
           },
           "select_timeout": {
            "color": "red",
            "index": 5
           },
           "echo_mismatch": {
            "color": "orange",
            "index": 6
           },
           "select_only": {
            "color": "orange",
            "index": 7
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  }
