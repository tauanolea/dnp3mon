      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT a AS master, count() AS rtus, countIf(o = 1) AS online\nFROM (SELECT rtu, argMax(active_master, minute) AS a, argMax(online, minute) AS o FROM dnp3.rtu_stats_1m WHERE minute <= $__toTime AND minute >= (SELECT max(minute) FROM dnp3.rtu_stats_1m WHERE minute <= $__toTime AND minute > $__toTime - INTERVAL 1 DAY) - INTERVAL 2 MINUTE GROUP BY rtu)\nGROUP BY master ORDER BY rtus DESC",
     "refId": "A"
