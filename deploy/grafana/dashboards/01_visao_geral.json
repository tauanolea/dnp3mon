  {
   "type": "timeseries",
   "title": "RTUs online × offline",
   "description": "",
   "id": 11,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT minute AS time, sum(s.online) AS rtus_online, count() - sum(s.online) AS rtus_offline\nFROM dnp3.rtu_stats_1m AS s WHERE $__timeFilter(s.minute) GROUP BY minute ORDER BY minute",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtus_offline"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "rtus_online"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Mensagens por tipo (por minuto)",
   "description": "",
   "id": 12,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(minute) AS time,\n  sum(integrity_req) / (greatest($__interval_s, 60) / 60) AS integridade, sum(event_poll_req) / (greatest($__interval_s, 60) / 60) AS varredura_eventos,\n  sum(app_unsol) / (greatest($__interval_s, 60) / 60) AS nao_solicitadas, sum(app_confirm) / (greatest($__interval_s, 60) / 60) AS confirmacoes,\n  sum(link_status_req) / (greatest($__interval_s, 60) / 60) AS link_status, sum(cmd_total) / (greatest($__interval_s, 60) / 60) AS comandos\nFROM dnp3.rtu_stats_1m WHERE $__timeFilter(minute) GROUP BY time ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Falhas de comunicação (por minuto)",
   "description": "",
   "id": 13,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
