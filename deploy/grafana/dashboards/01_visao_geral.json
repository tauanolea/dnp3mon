     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(minute) AS time, sum(pt_events) / (greatest($__interval_s, 60) / 60) AS eventos_pontos,\n  sum(pt_bin_changes) / (greatest($__interval_s, 60) / 60) AS mudancas_binarias, sum(iin_restart) / (greatest($__interval_s, 60) / 60) AS respostas_com_restart,\n  sum(iin_need_time) / (greatest($__interval_s, 60) / 60) AS respostas_need_time, sum(iin_overflow) / (greatest($__interval_s, 60) / 60) AS respostas_overflow\nFROM dnp3.rtu_stats_1m WHERE $__timeFilter(minute) GROUP BY time ORDER BY time",
     "refId": "A"
