  {
   "type": "table",
   "title": "Piores RTUs no período",
   "description": "",
   "id": 19,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 10,
    "y": 31,
    "w": 14,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT s.rtu AS rtu, inv.name AS nome, inv.medium AS meio,\n  round(100 * sum(s.online) / count(), 2) AS disponib_pct,\n  sum(s.app_timeouts) AS timeouts, sum(s.app_retries) AS retentativas,\n  round(sum(s.resp_sum_ms) / nullIf(sum(s.resp_cnt), 0)) AS resp_ms,\n  round(sum(s.tcp_rtt_sum_ms) / nullIf(sum(s.tcp_rtt_cnt), 0)) AS rtt_tcp_ms,\n  sum(s.tcp_retrans) AS retrans_tcp, sum(s.link_crc_err) AS crc,\n  sum(s.link_status_timeout) AS link_sem_resp, sum(s.cmd_fail) AS cmd_falhos\nFROM dnp3.rtu_stats_1m AS s LEFT JOIN (SELECT rtu, name, medium, region FROM dnp3.rtu_inventory FINAL) AS inv ON inv.rtu = toString(s.rtu)\nWHERE $__timeFilter(s.minute)\nGROUP BY s.rtu, inv.name, inv.medium\nORDER BY disponib_pct ASC, timeouts DESC\nLIMIT 50",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
