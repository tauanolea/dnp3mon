     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(minute) AS time,\n  sum(app_timeouts) / (greatest($__interval_s, 60) / 60) AS timeouts, sum(app_retries) / (greatest($__interval_s, 60) / 60) AS retentativas,\n  sum(unsol_retries) / (greatest($__interval_s, 60) / 60) AS nao_solic_repetidas, sum(link_status_timeout) / (greatest($__interval_s, 60) / 60) AS link_status_sem_resposta,\n  sum(link_crc_err) / (greatest($__interval_s, 60) / 60) AS erros_crc, sum(tcp_retrans) / (greatest($__interval_s, 60) / 60) AS retrans_tcp,\n  sum(tcp_connect_fail) / (greatest($__interval_s, 60) / 60) AS conexoes_falhas\nFROM dnp3.rtu_stats_1m WHERE $__timeFilter(minute) GROUP BY time ORDER BY time",
     "refId": "A"
    }
   ],
