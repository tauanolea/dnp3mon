   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT countIf(o = 1) FROM (SELECT rtu, argMax(online, minute) o FROM dnp3.rtu_stats_1m WHERE minute <= $__toTime AND minute >= (SELECT max(minute) FROM dnp3.rtu_stats_1m WHERE minute <= $__toTime AND minute > $__toTime - INTERVAL 1 DAY) - INTERVAL 2 MINUTE GROUP BY rtu)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
