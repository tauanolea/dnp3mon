     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT ifNull(nullIf(inv.medium, ''), '(sem inventário)') AS meio, uniqExact(s.rtu) AS rtus,\n  round(100 * sum(s.online) / count(), 2) AS disponib_pct,\n  round(sum(s.resp_sum_ms) / nullIf(sum(s.resp_cnt), 0)) AS resp_ms,\n  sum(s.app_timeouts) AS timeouts, round(1000 * sum(s.app_timeouts) / nullIf(sum(s.app_req), 0), 2) AS timeouts_por_mil\nFROM dnp3.rtu_stats_1m AS s LEFT JOIN (SELECT rtu, name, medium, region FROM dnp3.rtu_inventory FINAL) AS inv ON inv.rtu = toString(s.rtu)\nWHERE $__timeFilter(s.minute) GROUP BY meio ORDER BY rtus DESC",
     "refId": "A"
    }
   ],
   "fieldConfig": {
