  {
   "type": "table",
   "title": "Indicações IIN ativas",
   "description": "Bits de IIN de estado na última resposta: reinício, problema no equipamento, modo LOCAL, sem hora, configuração corrompida, estouro de buffer de eventos",
   "id": 20,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 10,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT rtu, arrayFilter(x -> x != '', [\n  if(bitTest(i, 15), 'RESTART', ''), if(bitTest(i, 14), 'TROUBLE', ''),\n  if(bitTest(i, 13), 'LOCAL', ''), if(bitTest(i, 12), 'NEED_TIME', ''),\n  if(bitTest(i, 5), 'CONFIG_CORRUPT', ''), if(bitTest(i, 3), 'EVENT_OVERFLOW', '')]) AS iin_ativos, m AS ultimo_minuto\nFROM (SELECT rtu, argMax(iin, minute) AS i, max(minute) AS m FROM dnp3.rtu_stats_1m WHERE minute <= $__toTime AND minute >= (SELECT max(minute) FROM dnp3.rtu_stats_1m WHERE minute <= $__toTime AND minute > $__toTime - INTERVAL 1 DAY) - INTERVAL 2 MINUTE GROUP BY rtu)\nWHERE i != 0 ORDER BY rtu",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
