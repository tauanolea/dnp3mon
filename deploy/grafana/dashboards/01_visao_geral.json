  {
   "type": "table",
   "title": "RTUs offline agora",
   "description": "",
   "id": 18,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 10,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT s.rtu AS rtu, inv.name AS nome, inv.medium AS meio,\n  maxIf(s.minute, s.online = 1) AS ultimo_online,\n  if(ultimo_online < toDateTime('2000-01-01'), NULL, dateDiff('minute', ultimo_online, $__toTime)) AS minutos_offline,\n  argMax(s.active_master, s.minute) AS master\nFROM dnp3.rtu_stats_1m AS s LEFT JOIN (SELECT rtu, name, medium, region FROM dnp3.rtu_inventory FINAL) AS inv ON inv.rtu = toString(s.rtu)\nWHERE s.minute > $__toTime - INTERVAL 7 DAY AND s.minute <= $__toTime\nGROUP BY s.rtu, inv.name, inv.medium\nHAVING argMax(s.online, s.minute) = 0\nORDER BY minutos_offline DESC",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
