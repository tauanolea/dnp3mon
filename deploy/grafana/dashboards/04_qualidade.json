  {
   "type": "table",
   "title": "Pontos mais ativos (candidatos a chattering)",
   "description": "",
   "id": 9,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT rtu, type AS tipo, idx AS indice, count() AS mudancas, countIf(is_event = 1) AS eventos, min(ts) AS primeira, max(ts) AS ultima\nFROM dnp3.points WHERE $__timeFilter(ts) AND type IN ('BI', 'DBI')\nGROUP BY rtu, type, idx ORDER BY mudancas DESC LIMIT 50",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
  {
   "type": "table",
   "title": "Relógio das RTUs (atraso dos eventos)",
   "description": "O atraso mínimo aproxima o erro do relógio da RTU somado à latência da rede.",
   "id": 10,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT s.rtu AS rtu, inv.medium AS meio, sum(s.ev_delay_cnt) AS eventos,\n  round(minIf(s.ev_delay_min_ms, s.ev_delay_cnt > 0)) AS atraso_min_ms,\n  round(sum(s.ev_delay_sum_ms) / sum(s.ev_delay_cnt)) AS atraso_medio_ms,\n  multiIf(atraso_min_ms < -1000, 'RELÓGIO ADIANTADO', atraso_min_ms > 60000, 'RELÓGIO ATRASADO / EVENTOS RETIDOS', atraso_min_ms > 5000, 'atenção', 'ok') AS avaliacao\nFROM dnp3.rtu_stats_1m AS s LEFT JOIN (SELECT rtu, name, medium, region FROM dnp3.rtu_inventory FINAL) AS inv ON inv.rtu = toString(s.rtu)\nWHERE $__timeFilter(s.minute) GROUP BY s.rtu, inv.medium HAVING eventos > 0\nORDER BY abs(atraso_min_ms) DESC LIMIT 100",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "atraso_min_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "atraso_medio_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "avaliacao"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "RELÓGIO ADIANTADO": {
            "color": "red",
            "index": 0
           },
           "RELÓGIO ATRASADO / EVENTOS RETIDOS": {
            "color": "red",
            "index": 1
           },
           "atenção": {
            "color": "orange",
            "index": 2
           },
           "ok": {
            "color": "green",
            "index": 3
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
  {
   "type": "table",
   "title": "Pontos com qualidade ruim agora",
   "description": "",
   "id": 11,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT rtu, type AS tipo, idx AS indice, value AS valor, flags,\n  arrayFilter(x -> x != '', [if(bitAnd(flags, 1) = 0, 'OFFLINE', ''), if(bitAnd(flags, 2) != 0, 'RESTART', ''), if(bitAnd(flags, 4) != 0, 'COMM_LOST', ''),\n    if(bitAnd(flags, 8) != 0, 'REMOTE_FORCED', ''), if(bitAnd(flags, 16) != 0, 'LOCAL_FORCED', '')]) AS qualidade, ts AS atualizado\nFROM dnp3.point_last FINAL WHERE type NOT IN ('BOC', 'AOC') AND (bitAnd(flags, 1) = 0 OR bitAnd(flags, 28) != 0)\nORDER BY rtu, tipo, indice LIMIT 1000",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "rtu"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Detalhe da RTU ${__value.raw}",
          "url": "/d/dnp3-rtu/dnp3-detalhe-da-rtu?var-rtu=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
  {
   "type": "table",
   "title": "Eventos de qualidade",
   "description": "",
   "id": 12,
