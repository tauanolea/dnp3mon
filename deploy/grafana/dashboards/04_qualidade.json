  {
   "type": "timeseries",
   "title": "Eventos e mudanças por minuto",
   "description": "",
   "id": 13,
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(minute) AS time, sum(pt_events) / (greatest($__interval_s, 60) / 60) AS eventos, sum(pt_static_changes) / (greatest($__interval_s, 60) / 60) AS mudancas_estaticos,\n  sum(pt_bad_quality) / (greatest($__interval_s, 60) / 60) AS pontos_qualidade_ruim\nFROM dnp3.rtu_stats_1m WHERE $__timeFilter(minute) GROUP BY time ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ],
